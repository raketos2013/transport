@using System.Security.Claims
@using FileManager.ViewModels
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model GroupsViewModel;
@{
    ViewData["Title"] = "Транспорт: Задачи";
    SelectList addresseeGroupsSelect = new SelectList(ViewBag.AddresseeGroups, "Id", "Name");
}

<div class="main-content">
    <div class="table-toolbar">
        <div class="toolbar-left">
            <div class="btn-full" onclick="ShowTaskList()">
                Обновить
            </div>
            <div class="btn-full" onclick="CreateTask()">
                Новая задача
            </div>
            <div class="btn-full" onclick="ShowActiveTask()">
                <span><span id="titleButton">Скрыть </span> неактивные</span>
            </div>
            <div class="btn-full" onclick="CopyTask()">
                Копировать задачу
            </div>
            <div>
                <a class="btn-full" asp-controller="Task" asp-action="TaskStatuses">
                    Статус задач
                </a>
            </div>

            <div class="filter-wrapper">
                <div class="btn-full btn-filter" onclick="ShowHideSubMenu('task-filter')">
                    Фильтр
                </div>
                <div class="filter" id="task-filter">
                    <div class="filter-body" method="post" id="filter-form">
                        <div class="filter-body-row">
                            <div class="filter-body-column">
                                <div class="input-with-label">
                                    <label>Идентификатор</label>
                                    <input id="TaskId">
                                    <div class="select-wrapper-options">
                                        <select id="TaskId-option">
                                            <option>=</option>
                                            <option>!=</option>
                                            <option>></option>
                                            <option>&lt;</option>
                                            <option>>=</option>
                                            <option>&lt;=</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="input-with-label">
                                    <label>Время начала</label>
                                    <input type="time" id="TimeBegin" step="1" value="00:00:00">
                                    <div class="select-wrapper-options">
                                        <select id="TimeBegin-option" style="width: 50px;">
                                            <option>=</option>
                                            <option>!=</option>
                                            <option>></option>
                                            <option>&lt;</option>
                                            <option>>=</option>
                                            <option>&lt;=</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="input-with-label">
                                    <label>Статус</label>
                                    <div class="select-wrapper">
                                        <select id="Status" asp-items="Html.GetEnumSelectList<StatusTaskViewModel>()"></select>
                                    </div>
                                    <div class="select-wrapper-options">
                                        <select id="Status-option" style="width: 50px;">
                                            <option>=</option>
                                            <option>!=</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="input-with-label">
                                    <label class="control-label">Группы рассылки</label>
                                    <div class="select-wrapper">
                                        <select id="AddresseeGroupId" class="form-select mb-3" asp-items=@addresseeGroupsSelect></select>
                                    </div>
                                    <div class="select-wrapper-options">
                                        <select id="AddresseeGroupId-option" style="width: 50px;">
                                            <option>=</option>
                                            <option>!=</option>
                                            <option>></option>
                                            <option>&lt;</option>
                                            <option>>=</option>
                                            <option>&lt;=</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="filter-body-column">
                                <div class="input-with-label">
                                    <label>Наименование</label>
                                    <input id="Name">
                                    <div class="select-wrapper-options">
                                        <select id="Name-option" style="width: 50px;">
                                            <option>=</option>
                                            <option>!=</option>
                                            <option>></option>
                                            <option>&lt;</option>
                                            <option>>=</option>
                                            <option>&lt;=</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="input-with-label">
                                    <label>Время окончания</label>
                                    <input type="time" id="TimeEnd" step="1" value="00:00:00">
                                    <div class="select-wrapper-options">
                                        <select id="TimeEnd-option" style="width: 50px;">
                                            <option>=</option>
                                            <option>!=</option>
                                            <option>></option>
                                            <option>&lt;</option>
                                            <option>>=</option>
                                            <option>&lt;=</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="input-with-label">
                                    <label>Дни активности</label>
                                    <div class="select-wrapper">
                                        <select id="DayActive" asp-items="Html.GetEnumSelectList<DayActiveViewModel>()"></select>
                                    </div>
                                    <div class="select-wrapper-options">
                                        <select id="DayActive-option" style="width: 50px;">
                                            <option>=</option>
                                            <option>!=</option>
                                            <option>></option>
                                            <option>&lt;</option>
                                            <option>>=</option>
                                            <option>&lt;=</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="input-with-label">
                                    <label>Осталось выполнений</label>
                                    <input id="LeftExecution" type="number">
                                    <div class="select-wrapper-options">
                                        <select id="LeftExecution-option" style="width: 50px;">
                                            <option>=</option>
                                            <option>!=</option>
                                            <option>></option>
                                            <option>&lt;</option>
                                            <option>>=</option>
                                            <option>&lt;=</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="filter-footer">
                        <div class="btn-full" id="sendFilter" onclick="ClearFilterTasks()">
                            Сбросить
                        </div>
                        <div class="btn-full" id="sendFilter" onclick="FilterTasks()">
                            Поиск
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="toolbar-right">
            <div class="input-group">
                <div class="select-wrapper">
                    <select id="select-find-task">
                        <option>Идентификатор</option>
                        <option>Наименование</option>
                        <option>Время начала</option>
                        <option>Время окончания</option>
                        <option>Группа рассылки</option>
                    </select>
                </div>
                <input onkeyup="FindOfTable(document.querySelector('#select-find-task'))" id="input-find-task">
            </div>
        </div>
    </div>
    <div id="tasks">
    </div>
</div>
<footer>
    <div class="pagination">
    </div>
</footer>
