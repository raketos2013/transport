    const sortDirections = {};

    function sortTable(columnIndex) {
        const table = document.getElementById("tableUserLogs");
        const tbody = table.querySelector("tbody");
        const rows = Array.from(tbody.rows);

        // Переключаем направление
        sortDirections[columnIndex] = !sortDirections[columnIndex];
        const isAsc = sortDirections[columnIndex];

        rows.sort((a, b) => {
            let valA = a.cells[columnIndex].textContent.trim();
            let valB = b.cells[columnIndex].textContent.trim();

            // 1. Сортировка Даты
            if (columnIndex === 1) {
                // Превращаем "15.04.2024" в объект даты для сравнения
                const dateA = new Date(valA.split('.').reverse().join('-'));
                const dateB = new Date(valB.split('.').reverse().join('-'));

                return isAsc ? dateA - dateB : dateB - dateA;
            }

            // 2. Сортировка чисел (если нужно)
            if (!isNaN(valA) && !isNaN(valB) && valA !== '' && valB !== '') {
                return isAsc ? valA - valB : valB - valA;
            }

            // 3. Сортировка строк (Имя, Текст)
            // Здесь мы уверены, что valA и valB — строки
            return isAsc
                ? valA.localeCompare(valB)
                : valB.localeCompare(valA);
        });

        // Очищаем и вставляем отсортированные строки
        rows.forEach(row => tbody.appendChild(row));

        // Опционально: добавляем класс стрелочкам (div.sorter)
        updateSortIcons(columnIndex, isAsc);
    }

    function updateSortIcons(columnIndex, isAsc) {
        document.querySelectorAll('.sorter').forEach((el, idx) => {
            el.classList.remove('asc', 'desc');
            if (idx === columnIndex) {
                el.classList.add(isAsc ? 'asc' : 'desc');
            }
        });
    }

    function ShowLogList() {

        $.ajax({
            method: 'POST',
            url: '@Url.Action("LogsList", "UserLogs")',
            data: { },
            dataType: 'html',
            success: function (result) {
                $('#logList').empty();
                $('#logList').append(result);
            }
        });
    }
    function Filter(){
        var dateFrom = document.getElementById('dateFrom').value;
        var dateTo = document.getElementById('dateTo').value;
        $.ajax({
            method: 'POST',
            url: '@Url.Action("LogsList", "UserLogs")',
            data: { "dateFrom" : dateFrom,
                    "dateTo" : dateTo },
            dataType: 'html',
            success: function (result) {
                $('#logList').empty();
                $('#logList').append(result);
            }
        });
    }

