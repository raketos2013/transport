            </svg>
        </div>
        <div class="modal-body without-footer" id="userlog-details-content">
        </div>

    </div>
</div>

<script>

    window.addEventListener('load', () => {
    //    ShowLogList();
        document.getElementById('menu-item-user-logs').style.backgroundColor = '#004830'

        ShowTitlePage("Логи пользователей")
